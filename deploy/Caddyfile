# Front door for every published port. Caddy sets X-Forwarded-For to the real client address (it ignores
# any value the client sends), which the API uses for its per-visitor rate limit.

# Production over HTTPS. Caddy gets and renews the Let's Encrypt certificate by itself.
erp.bipgulf.com {
	encode gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	reverse_proxy web-prod:3000
}

# UAT portal (plain HTTP on the server's address).
http://:8088 {
	encode gzip
	reverse_proxy web:3000
}

# Production on its plain-HTTP port, kept for the deploy health check; sign-in needs the HTTPS address.
http://:8089 {
	encode gzip
	reverse_proxy web-prod:3000
}
