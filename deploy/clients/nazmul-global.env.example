# Nazmul Global Company: copy to nazmul-global.env and fill in the secrets. Never commit the real file.

# --- secrets (generate fresh values per client) ---
# 32 random bytes, base64:  openssl rand -base64 32
FATOORA_MASTER_KEY=
# at least 32 characters:   openssl rand -base64 48
FATOORA_JWT_SECRET=
DB_PASSWORD=
FATOORA_ADMIN_EMAIL=admin@example.com
# at least 12 characters; change it after first login
FATOORA_ADMIN_PASSWORD=
FATOORA_ADMIN_NAME="Nazmul Admin"
FATOORA_COOKIE_SECURE=true

# --- your provider account (ZATCA onboarding, environment, legal details; the client never sees these) ---
FATOORA_OPERATOR_EMAIL=
FATOORA_OPERATOR_PASSWORD=
FATOORA_OPERATOR_NAME="E-invoicing Provider"

# --- client's normal staff account (invoices, customers, products, dues; no dashboard or sales report) ---
FATOORA_USER_EMAIL=
# at least 12 characters
FATOORA_USER_PASSWORD=
FATOORA_USER_NAME="Staff"

# --- payment reminders (every 15 days to customers with a due balance) ---
# Public portal address, used for invoice PDF links in reminders
FATOORA_PORTAL_URL=https://invoice.example.com
FATOORA_REMINDERS_ENABLED=true
FATOORA_REMINDER_INTERVAL=P15D
# Email (SMTP). Leave FATOORA_SMTP_HOST empty to only log reminder emails.
FATOORA_SMTP_HOST=
FATOORA_SMTP_PORT=587
FATOORA_SMTP_USERNAME=
FATOORA_SMTP_PASSWORD=
FATOORA_SMTP_STARTTLS=true
FATOORA_MAIL_FROM=
# SMS: generic HTTP form POST. Leave FATOORA_SMS_URL empty to only log reminder SMS.
#   Unifonic: URL=https://el.cloud.unifonic.com/rest/SMS/messages TO_PARAM=Recipient TEXT_PARAM=Body
#             SENDER_PARAM=SenderID EXTRA_PARAMS=AppSid=<your app sid>
#   Twilio:   URL=https://api.twilio.com/2010-04-01/Accounts/<sid>/Messages.json TO_PARAM=To TEXT_PARAM=Body
#             SENDER_PARAM=From AUTH_HEADER="Basic <base64 sid:token>"
FATOORA_SMS_URL=
FATOORA_SMS_AUTH_HEADER=
FATOORA_SMS_TO_PARAM=to
FATOORA_SMS_TEXT_PARAM=text
FATOORA_SMS_SENDER_PARAM=sender
FATOORA_SMS_SENDER=
FATOORA_SMS_EXTRA_PARAMS=

# --- seller profile (from the VAT registration certificate and national address) ---
ORG_LEGAL_NAME_AR="شركة نازمول جلوبال"
ORG_LEGAL_NAME_EN="Nazmul Global Company"
ORG_VAT_NUMBER=314920207600003
ORG_CR_NUMBER=7054854679
ORG_STREET="الملك فيصل بن عبد العزيز"
ORG_BUILDING_NUMBER=3287
ORG_ADDITIONAL_NUMBER=9519
ORG_DISTRICT="حي النهضة"
ORG_CITY="البكيرية"
ORG_POSTAL_CODE=52727
ORG_EMAIL=
ORG_PHONE=
# SANDBOX → SIMULATION → PRODUCTION (see docs/zatca-go-live.md)
ORG_ZATCA_ENVIRONMENT=SANDBOX
